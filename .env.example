# Environment Variables Template
# Copy this to .env and fill in your actual values

# TextRP / Matrix homeserver (required)
TEXTRP_HOMESERVER=https://synapse.textrp.io
# Full Matrix sender user ID for appservice sender
TEXTRP_USERNAME=@yourbot:synapse.textrp.io

# Synapse appservice settings (required)
MATRIX_AS_ID=textrp-bot
MATRIX_AS_SENDER_LOCALPART=yourbot
MATRIX_AS_TOKEN=replace_with_generated_appservice_token
MATRIX_HS_TOKEN=replace_with_generated_homeserver_token
MATRIX_AS_URL=https://faucetbot.textrp.io
MATRIX_AS_HOST=0.0.0.0
MATRIX_AS_PORT=9009

# TextRP Settings (optional)
TEXTRP_DEVICE_NAME=TextRP Chatbot
# Stable device ID for E2EE key persistence (auto-generated if omitted)
# TEXTRP_DEVICE_ID=
# TEXTRP_ROOM_ID is optional - bot will accept room invitations if not set
# TEXTRP_ROOM_ID=!yourroomid:synapse.textrp.io

# XRPL Configuration (optional)
XRPL_NETWORK=mainnet
# XRPL_RPC_URL is optional - uses default network endpoints if not set
# XRPL_RPC_URL=https://your-custom-rpc-endpoint.com

# Faucet Configuration
FAUCET_WALLET_SEED=your_faucet_wallet_seed
FAUCET_CURRENCY_CODE=TXT
FAUCET_DAILY_AMOUNT=100
FAUCET_COOLDOWN_HOURS=24
FAUCET_MIN_XRP_BALANCE=0.1
TOKEN_ISSUER=your_token_issuer_address
# FAUCET_COLD_WALLET=
# FAUCET_ADMIN_USERS=@user1:synapse.textrp.io,@user2:synapse.textrp.io
# HotPocket contract websocket endpoints for faucet state RPC.
# Comma-separated wss:// endpoints. For hpdevkit, start with a single node endpoint.
HP_CONTRACT_SERVERS=wss://localhost:8081
# Timeout for contract RPC responses in milliseconds.
HP_CONTRACT_TIMEOUT_MS=15000

# LP / NFT Multiplier Configuration (optional)
# Format: issuer:taxon,issuer:taxon
LP_INFO=rsRfacvEVocG5rtjV2QcfLEKYyxKnjkjfb:22943,rsRfacvEVocG5rtjV2QcfLEKYyxKnjkjfb:1015

# Bot Settings (optional)
# BOT_COMMAND_PREFIX=!
# BOT_LOG_LEVEL=INFO
# Set to 'true' if you want the bot to invalidate its token on shutdown (more secure)
# Set to 'false' to keep the token valid across restarts (more convenient)
INVALIDATE_TOKEN_ON_SHUTDOWN=false
